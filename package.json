{
  "name": "quantum-potential",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive quantum mechanics simulation exploring bound states in potential wells with real-time solutions to the 1D Schr\u00f6dinger equation.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenLyceum/QuantumPotential.git"
  },
  "keywords": [
    "quantum-physics",
    "quantum-mechanics",
    "schrodinger-equation",
    "physics-simulation",
    "educational-software",
    "interactive-visualization",
    "bound-states",
    "wavefunction",
    "scenerystack",
    "pwa"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:single": "tsc && vite build --mode single",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.accuracy.json --noEmit",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:accuracy": "tsx --tsconfig tsconfig.accuracy.json --import ./tests/accuracy/browser-globals.js tests/accuracy/run-terminal-tests.js",
    "test:wavefunction": "tsx --tsconfig tsconfig.accuracy.json --import ./tests/accuracy/browser-globals.js tests/accuracy/test-wavefunction-comprehensive.ts",
    "test:double-well": "tsx --tsconfig tsconfig.accuracy.json --import ./tests/accuracy/browser-globals.js tests/accuracy/test-double-well.ts",
    "test:coulomb": "tsx --tsconfig tsconfig.accuracy.json --import ./tests/accuracy/browser-globals.js tests/accuracy/verify-coulomb.ts",
    "test:multi-square-well": "tsx --tsconfig tsconfig.accuracy.json --import ./tests/accuracy/browser-globals.js tests/accuracy/test-multi-square-well.ts",
    "test:multi-coulomb-1d": "tsx --tsconfig tsconfig.accuracy.json --import ./tests/accuracy/browser-globals.js tests/accuracy/test-multi-coulomb-1d.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "clean": "rm -rf dist",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "scenerystack": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^24.13.4",
    "happy-dom": "^20.14.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "lodash": "~4.18.1",
    "three": "~0.125.2",
    "brace-expansion": "~5.0.9"
  }
}
