{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": false,
    // The legacy accuracy/diagnostic scripts under tests/accuracy/ predate the fleet's strict
    // index-access flags. They are run by hand (npm run test:accuracy etc.), not by CI.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "types": ["node"]
  },
  "include": ["tests/accuracy"],
  // Stale against the current analytical-solver signatures (and already crashing on main before the
  // fleet migration) — see CLAUDE.md "Compliance carve-outs". Repair, then drop this exclude.
  "exclude": ["tests/accuracy/test-wavefunction-comprehensive.ts"]
}
